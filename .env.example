# mctl Academy — environment reference
#
# Copy to `.env` for local work; nothing reads `.env.example` itself. Every
# variable the code actually reads is listed here (source of truth:
# `grep -r process.env` plus .github/workflows/ and the deploy checklist) —
# if you add a `process.env.X`, add it here in the same commit.
#
# Each entry states four things, because they are not derivable from the name:
#
#   scope     server (runtime) | build (content/artefact scripts) | ci | e2e
#   required  yes | optional (with its default) | production-only
#   secret    yes -> Vault via secret_env_vars, never a plain env var
#             no  -> safe in values.yaml / workflow env
#   note      production-only constraints, when any
#
# PLATFORM CONSTRAINT — applies to every value below that contains a colon
# (every URL, every connection string): `mctl_deploy_service`'s env_vars
# silently DROPS any value containing `:`. Those must go through
# `secret_env_vars` into Vault, even the ones that are not secrets. Keeping
# the plain `env:` block to colon-free scalars is also what stops
# `action=deploy` from wiping it on a tag bump. See PLAN.md section 8.

# ---------------------------------------------------------------- database

# scope: server, build (scripts/migrate.mjs)   required: yes   secret: yes
# Contains a colon -> Vault only, never env_vars.
# Absence is fatal at boot in every environment, not just production: the app
# refuses to fall back to an in-memory store, which would silently lose all
# sessions and attempts on restart (and better-auth has no such fallback at
# all). CNPG requires SSL — server/db-ssl.mjs derives the mode from NODE_ENV,
# so do not append sslmode= here.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mctl_academy

# ------------------------------------------------------------------- auth

# scope: server   required: production-only (fatal if missing)   secret: yes
# Unset outside production, better-auth signs session cookies with its own
# public, hardcoded dev secret — which in production would let anyone forge a
# valid session for any user id, with no error and no log line. That is why
# the app refuses to boot without it when NODE_ENV=production.
BETTER_AUTH_SECRET=change-me-locally-any-random-string

# scope: server   required: optional   secret: no (but contains a colon -> Vault)
# better-auth's own base URL. Left unset, better-auth derives the origin from
# the incoming request and logs a warning; callbacks and redirects may then be
# wrong behind a proxy, so set it in any deployed environment.
BETTER_AUTH_URL=http://localhost:8080

# scope: server   required: optional   secret: no (but contains a colon -> Vault)
# Two independent jobs, both worth setting wherever the app is reachable at a
# fixed origin: it is better-auth's trusted origin, and it is the origin
# server/middleware/csrf.mjs compares against for state-changing requests.
# Unset, that check falls back to the request's own URL origin.
PUBLIC_BASE_URL=http://localhost:8080

# scope: server   required: optional (sign-in is simply unavailable without them)
# secret: GITHUB_CLIENT_SECRET yes; GITHUB_CLIENT_ID no
# server/auth.mjs registers the GitHub provider only when BOTH are set — a
# half-configured pair silently yields PROVIDER_NOT_FOUND rather than an error
# at boot.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# scope: server   required: optional   secret: GOOGLE_CLIENT_SECRET yes
# Same both-or-neither rule as GitHub above.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --------------------------------------------------------------- allowlists

# scope: server   required: optional   secret: no
# Comma-separated GitHub logins, matched case-insensitively against the
# signed-in user's githubLogin. Both routes FAIL SHUT: with the list unset
# they 404 for everyone, including the maintainer — an unconfigured
# environment is closed, not open. The 404 (rather than 403) is deliberate so
# the route's existence is not disclosed to non-moderators.
MCTL_ACADEMY_MODERATORS=
MCTL_ACADEMY_STATS_ADMINS=

# ------------------------------------------------------------------ runtime

# scope: server   required: optional (default 8080)   secret: no
PORT=8080

# scope: server   required: optional (default unset = development)   secret: no
# This app's single signal for "we are behind the production ingress". It
# gates three separate behaviours, so do not set it casually in local work:
# HSTS emission, CNPG SSL mode (server/db-ssl.mjs), and the fatal-on-missing
# BETTER_AUTH_SECRET check.
NODE_ENV=development

# ------------------------------------------------------------- rate limiting

# scope: server   required: optional   secret: no
# Defaults: 10 requests per 10 minutes per client, store capped at 5000
# entries. The limiter keys on CF-Connecting-IP only (Cloudflare overwrites it
# unconditionally); X-Forwarded-For is deliberately NOT trusted, since a proxy
# only appends to it and a client-supplied prefix would survive. At capacity
# the store sweeps expired entries and then fails closed rather than evicting
# a still-active window.
RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_MAX=10
RATE_LIMIT_MAX_ENTRIES=5000

# ------------------------------------------------- build / content scripts

# scope: build   required: optional   secret: no
# Path overrides used by the content scripts and their tests. Unset, they
# resolve to the repo's own content/ and client/src/ locations; the test
# suites set them to temp dirs so a test run never writes real artefacts.
ACADEMY_CONTENT_DIR=
ACADEMY_BUNDLE_OUT=
ACADEMY_CATALOG_OUT=
ACADEMY_PREVIEW_OUT=

# scope: build   required: optional   secret: no
# scripts/approve-pr-questions.mjs records who approved an item. It falls back
# GITHUB_USER -> MAINTAINER_HANDLE -> USER, and errors if none resolves.
# CONTENT-POLICY.md separates authorship from approval mechanically, so this
# names a human approver — never an agent.
MAINTAINER_HANDLE=

# ------------------------------------------------ evidence snapshots (R2)

# scope: build, ci   required: optional   secret: R2_ACCESS_KEY_ID and
# R2_SECRET_ACCESS_KEY yes; R2_ACCOUNT_ID and R2_BUCKET no
# scripts/lib/snapshot-store.mjs returns no store unless ACCOUNT_ID,
# ACCESS_KEY_ID and SECRET_ACCESS_KEY are all present, so citation
# verification degrades to a no-op rather than failing loudly. This is why
# content PRs from forks are not accepted: GitHub does not expose secrets to
# fork-triggered workflows, so the R2-backed check physically cannot run
# there. See SOURCES.md and CONTRIBUTING.md.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=academy-source-snapshots

# ---------------------------------------------------------------- e2e / ci

# scope: e2e   required: optional   secret: no
# playwright.config.ts: ACADEMY_E2E_PORT (default 8090) picks the port for the
# server it starts; E2E_BASE_URL points the suite at an already-running
# instance instead. CI is set by GitHub Actions itself and switches the
# reporter and reuseExistingServer — do not set it by hand locally.
ACADEMY_E2E_PORT=8090
E2E_BASE_URL=
