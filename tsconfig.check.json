{
  // Type-checking for the plain-JavaScript half of the repo. Nothing is
  // emitted: this is a linter that happens to be tsc. The .mjs files run as
  // they are -- on Bun in the image, on Node in the test suites -- and no
  // build step is introduced by this file.
  //
  // `include` grows one directory at a time, and that is the point. Turning
  // checkJs on everywhere at once buries the handful of real defects in a
  // long tail of noise, and a check nobody reads is worse than no check. A
  // directory joins the list in the PR that makes it pass; see PLAN.md.
  //
  // Coverage is now the whole .mjs side: server/, migrations/, scripts/ and
  // tests/. Nothing is left to add; what remains is tightening the options,
  // starting from `strict: false` below.
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    // "bun" because server/index.mjs branches on `Bun` to pick its HTTP
    // server; "node" because the very same file falls back to
    // @hono/node-server and the suites run it there.
    "types": ["node", "bun"],
    // `strict` is an umbrella over eight options with wildly different costs
    // here, so it stays off and the members are enabled individually. Measured
    // against the current tree (each option alone, everything else as below):
    //
    //   noImplicitThis              0     enabled
    //   strictFunctionTypes         0     enabled
    //   strictBindCallApply         0     enabled
    //   alwaysStrict                0     enabled
    //   useUnknownInCatchVariables  19
    //   strictNullChecks            78
    //   noImplicitAny             272
    //   strict (all together)     348
    //
    // The four above cost nothing today. They are on not because they found
    // anything, but because they are ratchets: free now, and expensive to
    // adopt later once code has been written against their absence.
    //
    // The rest wait for a PR each, argued on its own evidence. Sizes are not
    // the whole story -- useUnknownInCatchVariables' 19 are all `err.message`
    // in a catch, and fixing them adds a narrowing dance to every error path
    // for a throw shape this codebase does not actually produce. Note also
    // that noImplicitAny, not strictNullChecks, is the real wall; an earlier
    // version of this comment guessed the opposite.
    "noImplicitThis": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "alwaysStrict": true,
    "strict": false
  },
  "include": ["server/**/*.mjs", "migrations/**/*.mjs", "scripts/**/*.mjs", "tests/**/*.mjs"]
}
