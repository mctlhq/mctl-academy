{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://academy.mctl.ai/schemas/course/1.json",
  "title": "Course definition",
  "description": "Schema for mctl Academy certification course maps.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "prepares_for",
    "title",
    "description",
    "mock",
    "domains"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,62}$"
    },
    "prepares_for": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200
    },
    "title": {
      "type": "string",
      "minLength": 2,
      "maxLength": 100
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 2000
    },
    "disclaimer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "short": { "type": "string" },
        "full": { "type": "string" }
      }
    },
    "mock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question_count", "time_limit_minutes"],
      "properties": {
        "question_count": { "type": "integer", "minimum": 5, "maximum": 100 },
        "time_limit_minutes": { "type": "integer", "minimum": 5, "maximum": 180 },
        "disclose_bank_size": { "type": "boolean" }
      }
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "weight", "mock_questions", "objectives"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^domain-[1-9][0-9]*$"
          },
          "title": {
            "type": "string",
            "minLength": 2,
            "maxLength": 200
          },
          "weight": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "mock_questions": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "objectives": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "title"],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"
                },
                "title": {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 300
                }
              }
            }
          }
        }
      }
    }
  }
}
