{
  "name": "mctl-academy-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Mock exam UI for mctl Academy (issue #20). Reads content/ at build time via a generated JSON bundle; no server exists yet.",
  "scripts": {
    "predev": "node ../scripts/build-content-bundle.mjs",
    "dev": "vite",
    "prebuild": "node ../scripts/build-content-bundle.mjs",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "pretest": "node ../scripts/build-content-bundle.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@mctlhq/css": "^0.4.0",
    "@mctlhq/ui": "^0.4.0",
    "better-auth": "^1.6.26",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.2.0",
    "yaml": "^2.6.1"
  }
}
