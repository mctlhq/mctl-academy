{
  "name": "mctl-academy-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Practice mode: a standalone, server-free React screen over the build-time content bundle.",
  "scripts": {
    "prebuild": "node ../scripts/build-content-bundle.mjs",
    "pretest": "node ../scripts/build-content-bundle.mjs",
    "build": "tsc --noEmit && vite build",
    "dev": "node ../scripts/build-content-bundle.mjs && vite",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^27.4.0",
    "typescript": "^5.7.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
