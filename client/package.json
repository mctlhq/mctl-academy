{
  "name": "mctl-academy-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Mock exam UI for mctl Academy (issue #20). Reads content/ at build time via a generated JSON bundle; no server exists yet.",
  "scripts": {
    "predev": "node scripts/build-content-bundle.mjs",
    "dev": "vite",
    "prebuild": "node scripts/build-content-bundle.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "pretest": "node scripts/build-content-bundle.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "yaml": "^2.6.1"
  }
}
