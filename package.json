{
  "name": "mctl-academy",
  "version": "0.1.25",
  "private": true,
  "type": "module",
  "description": "Free, evidence-backed practice for agentic AI certification",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/mctlhq/mctl-academy.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint:content": "node scripts/validate-content.mjs",
    "verify:evidence": "node scripts/verify-evidence.mjs",
    "snapshot:capture": "node scripts/capture-source.mjs",
    "test:content": "node --test 'tests/content-lint.test.mjs' 'tests/build-content-bundle.test.mjs' 'tests/build-preview.test.mjs' 'tests/verify-evidence.test.mjs'",
    "test:server": "node --test 'tests/server.test.mjs' 'tests/auth.test.mjs' 'tests/attempts.test.mjs' 'tests/account.test.mjs' 'tests/db-hard-fail.test.mjs' 'tests/readyz-live.test.mjs' 'tests/security-headers.test.mjs'",
    "start": "node server/index.mjs",
    "build:preview": "node scripts/build-preview.mjs",
    "migrate": "node scripts/migrate.mjs up",
    "migrate:down": "node scripts/migrate.mjs down"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "better-auth": "^1.6.26",
    "hono": "^4.13.1",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.22.0",
    "yaml": "^2.6.1"
  }
}
